# Provider Options: openai | google | ollama
PROVIDER=openai

# Model names:
# OpenAI: gpt-4o | gpt-4o-mini
# Google: gemini-1.5-pro | gemini-2.0-flash
# Ollama: mistral:latest | llama3 | codellama
MODEL=gpt-4o-mini

# OpenAI API Key (get from: <https://platform.openai.com/api-keys>)
OPENAI_API_KEY=

# Google Gemini API Key (get from: <https://aistudio.google.com/apikey>)
GOOGLE_API_KEY=

# Ollama Host (only for local Ollama)
OLLAMA_HOST=http://localhost:11434

# Optional Settings
LOG_LEVEL=INFO
OUTPUT_DIR=outputs

# Timeout
TIMEOUT=60

# Jira
JIRA_BASE_URL=http://localhost:4001
JIRA_TOKEN=mock-jira-token-2025

# TestRail
TESTRAIL_BASE_URL=http://localhost:4002
TESTRAIL_EMAIL=admin@testrail.mock
TESTRAIL_API_KEY=MockAPI@123
TESTRAIL_PROJECT_ID=1
TESTRAIL_SECTION_ID=1

# Slack
SLACK_BASE_URL=http://localhost:4003
SLACK_TOKEN=xoxb-mock-bot-token
SLACK_CHANNEL=qa-reports